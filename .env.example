# Dedicated Neon database named `voice`. Never point this at showroom neondb
# or at the lindsay / woolgrown app databases.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/voice?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/voice?sslmode=require"

OPENAI_API_KEY=""
# OPENAI_DRAFT_MODEL="gpt-4o"

# Apps send this when they call Voice. The local UI on localhost does not need it.
# Production Command uses the same value as Fly secret VOICE_API_SECRET on
# lindsay-voice and woolgrown-command. VOICE_URL=https://lindsay-voice.fly.dev
VOICE_API_SECRET=""

# Per-integration teach lever lives in each app, not here:
#   lindsay-assistant  VOICE_TEACH defaults on (local included)
#   WoolGrown          VOICE_TEACH defaults off locally, on in production
