generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GoldStatus {
  active
  dismissed
}

enum LearningStatus {
  active
  dismissed
}

enum LearningKind {
  voice
  fact
  unknown
}

enum ClassificationSource {
  same_call
  separate_call
  heuristic
  fallback
}

enum GenerationOutcome {
  pending
  kept
  edited
  rejected
}

model Profile {
  id             String     @id
  name           String
  description    String     @default("")
  guide          String
  systemPrompt   String
  bannedForPrompt String    @default("[]")
  surfaces       String     @default("[]")
  updatedAt      DateTime   @updatedAt
  golds          Gold[]
  learnings      Learning[]
  generationLogs GenerationLog[]
}

model Gold {
  id         String   @id
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title      String
  body       String
  /// Raw generate that she rewrote. Stored for later DPO. Never prompt this.
  rejected   String   @default("")
  source     String
  surface    String   @default("other")
  /// Host-supplied kind (e.g. how-to-steps). Empty = untyped. Voice does not interpret it.
  architecture String @default("")
  canonical  Boolean  @default(false)
  status     GoldStatus @default(active)
  createdAt  DateTime

  @@index([profileId, status, surface])
}

model Learning {
  id            String   @id
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rule          String
  status        LearningStatus @default(active)
  before        String   @default("")
  after         String   @default("")
  why           String   @default("")
  surface       String   @default("")
  kind                     LearningKind         @default(unknown)
  classificationSource     ClassificationSource @default(fallback)
  classificationMismatch   Boolean  @default(false)
  sourceDraftId String?
  createdAt     DateTime
  updatedAt     DateTime

  @@index([profileId, status, createdAt])
}

model GenerationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  surfaceId    String
  architecture String?
  seed         String?

  model         String?
  facts         String
  generatedBody String

  selectedGoldIds     String[]
  selectedLearningIds String[]
  warnings            String[]
  retried             Boolean  @default(false)
  retryReason         String?

  outcome    GenerationOutcome @default(pending)
  editedBody String?
  userNote   String?

  @@index([profileId, createdAt])
}
