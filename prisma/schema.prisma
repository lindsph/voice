generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GoldStatus {
  active
  dismissed
}

enum LearningStatus {
  active
  dismissed
  /// Held back automatically: it loosened the claims policy.
  blocked
  /// Held back automatically: a live rule already said the same.
  merged
  /// Replaced automatically by a newer rule that contradicted it.
  retired
}

enum LearningKind {
  voice
  fact
  unknown
}

enum ClassificationSource {
  same_call
  separate_call
  heuristic
  fallback
}

enum GenerationOutcome {
  pending
  kept
  edited
  rejected
}

model Profile {
  id             String     @id
  name           String
  description    String     @default("")
  guide          String
  systemPrompt   String
  bannedForPrompt String    @default("[]")
  surfaces       String     @default("[]")
  updatedAt      DateTime   @updatedAt
  golds          Gold[]
  learnings      Learning[]
  generationLogs GenerationLog[]
  evalCases      EvalCase[]
  evalRuns       EvalRun[]
}

model Gold {
  id         String   @id
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title      String
  body       String
  /// Raw generate that she rewrote. Stored for later DPO. Never prompt this.
  rejected   String   @default("")
  source     String
  surface    String   @default("other")
  /// Host-supplied kind (e.g. how-to-steps). Empty = untyped. Voice does not interpret it.
  architecture String @default("")
  canonical  Boolean  @default(false)
  status     GoldStatus @default(active)
  createdAt  DateTime

  @@index([profileId, status, surface])
}

model Learning {
  id            String   @id
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rule          String
  status        LearningStatus @default(active)
  before        String   @default("")
  after         String   @default("")
  why           String   @default("")
  surface       String   @default("")
  kind                     LearningKind         @default(unknown)
  classificationSource     ClassificationSource @default(fallback)
  classificationMismatch   Boolean  @default(false)
  sourceDraftId String?
  /// What the rule check did with this rule: blocked, merged or replaced (it retired autoTargetId).
  autoAction    String?
  autoReason    String   @default("")
  /// The live rule it duplicated or replaced.
  autoTargetId  String?
  autoAt        DateTime?
  /// Set when someone undid the automatic change.
  undoneAt      DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  @@index([profileId, status, createdAt])
  @@index([profileId, autoAt])
}

model GenerationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  surfaceId    String
  architecture String?
  seed         String?

  model         String?
  facts         String
  generatedBody String

  selectedGoldIds     String[]
  selectedLearningIds String[]
  warnings            String[]
  retried             Boolean  @default(false)
  retryReason         String?
  /// "plain" or "crafted". Lets kept/edited outcomes be compared by style.
  style               String   @default("plain")
  /// Crafted only: the planned way in.
  angle               String?

  outcome    GenerationOutcome @default(pending)
  editedBody String?
  userNote   String?

  @@index([profileId, createdAt])
}

/// One exam question for the voice eval: the brief Voice was given and what the
/// person actually published. Integrators add one when a piece goes live.
model EvalCase {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// The integrator's own id for the piece (e.g. a blog topic id). Golds and
  /// rules taught from this piece are left out while it is being tested.
  sourceId     String
  surfaceId    String
  architecture String?
  /// The brief, as Voice received it (from the GenerationLog when there is one).
  facts        String
  model        String?
  style        String   @default("plain")
  /// What the person published.
  finalBody    String
  generationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([profileId, sourceId])
  @@index([profileId, createdAt])
}

/// One run of the voice eval over a profile's cases, with its scorecard.
model EvalRun {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// running | done | failed
  status     String    @default("running")
  /// new-cases | monthly | manual | candidate
  trigger    String
  /// Candidate runs: what was changed (e.g. "her writing in the prompt").
  label      String?
  caseCount  Int       @default(0)
  /// { passes, cases, keptPercent, tellsPerCase }
  scoresJson String    @default("{}")
  /// Per case: sourceId, passed, keptPercent, tells, and the judge's reasons.
  casesJson  String    @default("[]")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([profileId, startedAt])
}
